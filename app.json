{
  "expo": {
    "name": "PRODEX Mobile",
    "slug": "prodex-mobile",
    "version": "1.0.0",
    "scheme": "prodex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "cloud.prodexhub.mobile",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "cloud.prodexhub.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/prodex-symbol.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "PRODEX necesita acceso a la cámara para escanear códigos de barras de productos."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/prodex-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5fb15704-786f-41df-8571-6b5a4ab3007a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5fb15704-786f-41df-8571-6b5a4ab3007a"
    }
  }
}
